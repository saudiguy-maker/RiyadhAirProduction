{
  "name": "riyadh-air-delivery-watch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "npm install && npm --prefix web install",
    "migrate": "node server/seed.js",
    "reseed": "node server/seed.js --force",
    "test": "node ingest/test/dedup.test.js",
    "dev:api": "INGEST=off node server/bridge.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node server/bridge.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "ws": "^8.18.0"
  }
}
