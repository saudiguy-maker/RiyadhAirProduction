{
  "name": "riyadh-air-delivery-watch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm --prefix web install",
    "migrate": "node server/migrate.js",
    "reseed": "node server/seed.js --force",
    "test": "node --test ingest/test/*.test.js server/test/*.test.js web/test/*.test.js",
    "dev:api": "INGEST=off node server/bridge.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node server/bridge.js",
    "seed": "node server/seed.js",
    "orders:import": "node server/import-orders.js",
    "evidence:import": "node server/import-evidence.js",
    "reports:export": "node server/refresh-reports.js"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
